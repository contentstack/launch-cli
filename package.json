{
  "name": "@contentstack/cli-launch",
  "version": "2.0.0-alpha.0",
  "description": "Launch related operations",
  "author": "Contentstack CLI",
  "bin": {
    "launch": "./bin/run.js"
  },
  "homepage": "https://github.com/contentstack/launch-cli",
  "license": "MIT",
  "main": "dist/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/contentstack/launch-cli.git"
  },
  "files": [
    "/bin",
    "/dist",
    "/npm-shrinkwrap.json",
    "/oclif.manifest.json"
  ],
  "dependencies": {
    "@contentstack/cli-command": "^1.8.7",
    "@contentstack/cli-utilities": "^1.18.5",
    "@oclif/core": "^4.2.7",
    "@oclif/plugin-help": "^6.2.25",
    "@rollup/plugin-commonjs": "^28.0.9",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "adm-zip": "^0.6.1",
    "chalk": "^4.1.2",
    "dotenv": "^16.4.7",
    "express": "^4.22.0",
    "ini": "^3.0.1",
    "lodash": "^4.18.1",
    "open": "^8.4.2",
    "rollup": "^4.63.4"
  },
  "devDependencies": {
    "@oclif/test": "^4.2.0",
    "@types/express": "^4.17.25",
    "@types/express-serve-static-core": "^4.19.9",
    "@types/jest": "^29.5.14",
    "@types/lodash": "^4.17.13",
    "@types/node": "^22.0.0",
    "eslint": "^9.24.0",
    "eslint-config-oclif": "^6.0.42",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^15.5.0",
    "nock": "^13.5.6",
    "oclif": "^4.17.30",
    "shx": "^0.4.0",
    "ts-jest": "^29.3.1",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "typescript": "^5.8.3"
  },
  "oclif": {
    "bin": "csdx",
    "commands": "./dist/commands",
    "plugins": [
      "@oclif/plugin-help",
      "@oclif/plugin-plugins"
    ],
    "topicSeparator": ":",
    "topics": {
      "launch": {
        "description": "Manage Contentstack Launch projects and cloud functions"
      },
      "launch:projects": {
        "description": "Manage Launch projects"
      },
      "launch:functions": {
        "description": "Run Launch cloud functions locally"
      }
    },
    "additionalHelpFlags": [
      "-h"
    ],
    "additionalVersionFlags": [
      "-v"
    ],
    "repositoryPrefix": "<%- repo %>/blob/main/packages/contentstack-launch/<%- commandPath %>"
  },
  "scripts": {
    "build": "npm run clean && npm run compile",
    "clean": "rm -rf ./dist tsconfig.build.tsbuildinfo",
    "compile": "tsc -b tsconfig.json",
    "lint": "eslint 'src/**/*.{js,ts}'",
    "lint-staged": "lint-staged",
    "postpack": "shx rm -f oclif.manifest.json",
    "prepack": "npm run build && oclif manifest && oclif readme",
    "prepare": "husky",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand",
    "test:coverage": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand --coverage",
    "version": "oclif readme && git add README.md"
  },
  "overrides": {
    "ajv": "^8.18.0",
    "eslint": {
      "ajv": "^6.12.6"
    },
    "@eslint/eslintrc": {
      "ajv": "^6.12.6"
    },
    "qs": "^6.16.0",
    "tmp": "^0.2.4",
    "fast-uri": "^3.1.8",
    "proxy-addr": "^2.0.8",
    "minimatch@10.2.5": {
      "brace-expansion": "^5.0.9"
    },
    "minimatch@9.0.9": {
      "brace-expansion": "^2.1.4"
    },
    "minimatch@5.1.9": {
      "brace-expansion": "^2.1.4"
    },
    "serialize-javascript": "^7.1.0",
    "diff": "^8.0.3",
    "brace-expansion@1": "^1.1.18",
    "istanbul-lib-processinfo": {
      "uuid": "^11.1.1"
    }
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "bugs": "https://github.com/contentstack/launch-cli/issues",
  "keywords": [
    "oclif"
  ],
  "types": "dist/index.d.ts",
  "lint-staged": {
    "*.{js,ts}": [
      "eslint --fix"
    ]
  },
  "csdxConfig": {
    "shortCommandName": {
      "launch": "LNCH",
      "launch:logs": "LNCH-LGS",
      "launch:open": "LNCH-OPN",
      "launch:functions": "LNCH-FN",
      "launch:environments": "LNCH-ENV",
      "launch:deployments": "LNCH-DPLMNT"
    }
  }
}
