  checksum: d745e6efbb9c4595ee7c57a2625a73d687d3e880a346f53de2d7da183971d875
- filename: src/git/local-repository.ts
  checksum: 03d1f815701e27f241782b81fdb4c7d346c1a506c85c23cf8aae51c8bc51a42b
- filename: src/core/layering.test.ts
  checksum: ad03c58028a06745f1e14a8a143dd3a09807741f87afe99023a0f8a7be4164d2
- filename: src/commands/launch/projects/create.test.ts
  checksum: d271aa6c5a5067be9b27ab7c8d8f6dbde31a239783aeede7918ba49e3cefff72
version: "1.0"
