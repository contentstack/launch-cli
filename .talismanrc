    - "b2c3d4e5f60718293a4b5c6d"
    - "c3d4e5f60718293a4b5c6d7e"
- filename: src/core/rules.ts
  allowed_patterns:
    - "FlagKey"
- filename: src/resources.ts
  allowed_patterns:
    - "FlagKey"
- filename: src/resources.test.ts
  allowed_patterns:
    - "a project name passed on argv to the project resolver"
- filename: AGENTS.md
  allowed_patterns:
    - "Do not add an exemption to a guard to make a new file pass"
    - "passes its own error wording to `client.request\\(req, MESSAGES\\)`"
    - "a key of `ProjectConfig`"
    - "returns silently when `--yes` was passed"
    - "path the user passed with `--config`"
    - "what `limit` resolves to when nobody passed it"
    - "a test passes `var`, `env-file` and `from-stack`"
    - "an in-flight secret registry to redact against"
