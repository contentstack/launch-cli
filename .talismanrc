fileignoreconfig:
- filename: .github/workflows/secrets-scan.yml
  checksum: aa468892940460dd050b7bc2ec997d589fe88c3557779dabdb1583645e45b79b
- filename: .husky/secrets-scan.sh
  checksum: 5a44edca8d209ca4b7f6eefc4ce2caab838679f8916ef6136ad68584c0705cb6
- filename: package-lock.json
  ignore_detectors:
    - filecontent
- filename: test/integration/project-upload.test.ts
  allowed_patterns:
    - "key: 'Content-Type'"
    - "formFieldKey: 'key', formFieldValue"
    - "key: 'x-ms-blob-type', value: 'BlockBlob'"
- filename: src/projects/project.upload.ts
  allowed_patterns:
    - "formFieldKey"
    - "\\[header\\.key, header\\.value\\]"
    - "const \\[key, value\\] of"
- filename: src/projects/project.upload.test.ts
  allowed_patterns:
    - "formFieldKey"
    - "key: name, value: contents"
    - "formField\\('key', "
    - "headers: \\[\\{ key: '"
    - 'name="key"'
    - "drops a field with no key"
- filename: src/commands/launch/projects/update.test.ts
  allowed_patterns:
    - "a1b2c3d4e5f60718293a4b5c"
    - "Pass at least one of --name, --description"
    - "Object\\.keys\\(ProjectsUpdate\\.flags\\)"
- filename: test/integration/projects-update.test.ts
  allowed_patterns:
    - "a1b2c3d4e5f60718293a4b5c"
    - "mockImplementation\\(\\(key: string\\) => CONFIG\\[key\\]\\)"
    - "Pass at least one of --name, --description"
- filename: test/integration/organization-prompt.test.ts
  allowed_patterns:
    - "a1b2c3d4e5f60718293a4b5c"
    - "mockImplementation\\(\\(key: string\\) => values\\[key\\]\\)"
    - "Pass --org, set it in \\.cs-launch\\.json"
    - "when --org is passed"
- filename: src/commands/launch/projects/update.ts
  allowed_patterns:
    - "Pass at least one of --name, --description"
- filename: src/projects/project.presenter.ts
  allowed_patterns:
    - "keyof ProjectUpdate"
- filename: src/projects/project.presenter.test.ts
  allowed_patterns:
    - "a1b2c3d4e5f60718293a4b5c"
    - "b2c3d4e5f60718293a4b5c6d"
    - "c3d4e5f60718293a4b5c6d7e"
- filename: src/projects/projects.api.test.ts
  allowed_patterns:
    - "the caller passes neither"
    - "the caller must pass a uid instead"
    - "formFieldKey"
- filename: src/projects/project.create.test.ts
  allowed_patterns:
    - "'SECRET=hunter2'"
    - "formFieldKey"
- filename: test/integration/projects-create.test.ts
  allowed_patterns:
    - "mockImplementation\\(\\(key: string\\) => CONFIG\\[key\\]\\)"
    - "formFieldKey"
    - "key: 'x-ms-blob-type', value: 'BlockBlob'"
    - "key: 'Content-Type', value: 'application/zip'"
- filename: test/fixtures/README.md
  allowed_patterns:
    - "formFieldKey"
    - "\\{key, value\\}"
- filename: src/environments/environments.api.ts
  ignore_detectors:
    - filename
- filename: src/environments/environments.api.test.ts
  ignore_detectors:
    - filename
- filename: src/transport/envelope.ts
  ignore_detectors:
    - filename
- filename: src/transport/envelope.test.ts
  ignore_detectors:
    - filename
- filename: src/git/git.api.ts
  checksum: dc9951fbcf6c1204c5eedb84c476bcce7d83339b1515ec10143e4f06bafda1aa
  allowed_patterns:
    - "assertArray\\(response, key, `\\$\\{key\\} response`\\)"
- filename: src/environments/environment.inputs.ts
  ignore_detectors:
    - filename
- filename: src/core/inputs.ts
  allowed_patterns:
    - "FlagKey"
    - "InputKeys"
- filename: src/core/resolution.ts
  allowed_patterns:
    - "FlagKey"
- filename: test/fixtures/project-get.json
  allowed_patterns:
    - "a1b2c3d4e5f60718293a4b5c"
    - "b2c3d4e5f60718293a4b5c6d"
    - "c3d4e5f60718293a4b5c6d7e"
- filename: test/fixtures/projects-list.json
  allowed_patterns:
    - "a1b2c3d4e5f60718293a4b5c"
    - "b2c3d4e5f60718293a4b5c6d"
    - "c3d4e5f60718293a4b5c6d7e"
- filename: test/integration/projects-get.test.ts
  allowed_patterns:
